===================================================================
1. 하위 인코더 및 예측 헤드 모듈
===================================================================

CLASS XRFEncoder:
    METHOD Initialize(xrf_dim=23, hid=128):
        MLP = [Linear(xrf_dim -> hid), ReLU(), Dropout(0.1), Linear(hid -> hid), ReLU()]

    METHOD Forward(xrf_입력):
        RETURN MLP(xrf_입력)


CLASS XRFPredictor:
    METHOD Initialize(hid=128, out_dim=3):
        Head = [Linear(hid -> 128), ReLU(), Dropout(0.1), Linear(128 -> out_dim)]

    METHOD Forward(xrf_특성):
        RETURN Head(xrf_특성)


CLASS ImageEncoder:
    METHOD Initialize(out_dim=8, pretrained=True):
        Backbone = ResNet18 (사전학습 가중치 사용)
        Backbone의 최종 분류기(FC 레이어) 제거 (Identity 변환)
        Proj_Head = [Linear(512 -> 8), BatchNorm1d, ReLU(), Dropout(0.1)]

    METHOD Forward(이미지):
        특성 = Backbone(이미지)
        RETURN Proj_Head(특성)


CLASS ImageResidualHead:
    METHOD Initialize(in_dim=8, out_dim=3):
        Head = [Linear(8 -> 128), ReLU(), Dropout(0.1), Linear(128 -> 3)]
        
        // 잔차 초기 영향을 최소화하기 위해 가중치를 정규분포(std=1e-3), 편향을 0으로 초기화
        가중치_초기화: Normal(mean=0.0, std=0.001), 편향=0.0

    METHOD Forward(이미지_특성):
        RETURN Head(이미지_특성)


CLASS GateNet:
    METHOD Initialize(xrf_hid=128, img_hid=8):
        Net = [Linear(128 + 8 -> 128), ReLU(), Dropout(0.1), Linear(128 -> 3)]
        
        // 핵심 이점: 마지막 레이어 편향을 -4.0으로 고정하여
        // Sigmoid(-4.0) ≈ 0.018 초깃값을 형성 (초기 학습 시 XRF 기저 예측을 보호)
        최종_레이어_가중치 = 0.0
        최종_레이어_편향 = -4.0

    METHOD Forward(xrf_특성, 이미지_특성):
        결합_특성 = Concatenate([xrf_특성, 이미지_특성])
        RETURN Sigmoid(Net(결합_특성))


===================================================================
2. Gated Residual Fusion 통합 네트워크
===================================================================

CLASS GatedResidualFusion:

    METHOD Initialize(xrf_dim=23):
        xrf_enc   = XRFEncoder(xrf_dim)
        xrf_pred  = XRFPredictor()
        img_enc   = ImageEncoder()
        img_delta = ImageResidualHead()
        gate      = GateNet()


    METHOD Forward(이미지, xrf):
        // [1] XRF 화학 데이터 기반 기저 물리치 예측
        xrf_특성 = xrf_enc(xrf)
        기저_예측 = xrf_pred(xrf_특성)

        // [2] 이미지 기반 잔차(Delta) 추론
        이미지_특성 = img_enc(이미지)
        잔차_보정치 = img_delta(이미지_특성)

        // [3] 동적 게이팅 가중치 계산 (0.0 ~ 1.0 범위)
        게이트_가중치 = gate(xrf_특성, 이미지_특성)

        // [4] 융합 예측: 기저_예측 + (게이트_가중치 * 잔차_보정치)
        최종_예측 = 기저_예측 + (게이트_가중치 * 잔차_보정치)
        최종_예측 = Clamp(최종_예측, 0.0, 1.0) // [0.0, 1.0] 범위 제약

        RETURN 최종_예측, 기저_예측, 게이트_가중치, 이미지_특성


===================================================================
3. GradCAM (Gradient-weighted Class Activation Mapping) 시각화
===================================================================

CLASS GradCAM:

    METHOD Initialize(모델, 타겟_레이어):
        타겟_레이어에 Forward 및 Backward 훅(Hook) 등록


    METHOD Generate_CAM(결합_특성, 클래스_확률, 클래스_인덱스, 입력_크기):
        모델 기울기 초기화
        타겟_값 = (결합_특성 * 가우시안_노이즈)의 합 * 클래스_확률[클래스_인덱스]
        타겟_값에 대해 역전파(Backward) 수행
        
        기울기(Gradients) 및 활성화맵(Activations) 추출
        
        // 채널별 기울기의 공간 평균(Global Average Pooling)으로 채널 가중치 도출
        채널_가중치 = Mean(기울기, axis=(높이, 너비))
        
        CAM = sum(채널_가중치[i] * 활성화맵[i])
        CAM = ReLU(CAM) // 양의 기여를 하는 특성만 남김
        
        입력 이미지 크기로 Resize 수행
        [0, 1] 범위로 Min-Max 정규화
        RETURN CAM

