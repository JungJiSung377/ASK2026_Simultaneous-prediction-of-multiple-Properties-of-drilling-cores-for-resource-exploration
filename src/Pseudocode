FUNCTION Eval_Metrics(예측값, 실제값, 클리핑여부=True):
    IF 클리핑여부 == True:
        예측값 = Clamp(예측값, 0.0, 1.0) // [0, 1] 물리적 범위 제약

    3개 타겟 물리 특성(PWV, Density, MS) 각각에 대해:
        R2_Score (결정계수) 리스트 계산
        MAE (평균 절대 오차) 리스트 계산
        RMSE (평균 제곱근 오차) 리스트 계산

    RETURN R2_리스트, MAE_리스트, RMSE_리스트


FUNCTION Interpret_Confidence(확률값):
    IF 확률값 > 0.9:  RETURN "Very High"
    IF 확률값 > 0.7:  RETURN "High"
    RETURN "Low"


===================================================================
2. 학습 단계별 파라미터 동적 제어 및 옵티마이저 생성 모듈
===================================================================

FUNCTION Set_Requires_Grad(모듈, 경사도_추적_여부):
    모듈 내 모든 파라미터의 requires_grad 속성을 설정
    (True = 가중치 업데이트 수행 / False = 파라미터 동결 Freezing)


FUNCTION Make_Optimizer(모델, 학습_단계, 학습률_설정):
    파라미터_그룹 = []
    가중치_감쇠(Weight Decay) = 학습률_설정["WEIGHT_DECAY"]

    // -------------------------------------------------------------
    // [Stage 1: Warmup] XRF 기저 모델 우선 학습
    // -------------------------------------------------------------
    IF 학습_단계 == "warmup":
        // XRF 인코더 및 예측 헤드만 활성화, 이미지/게이트 관련 모듈 동결
        Set_Requires_Grad(모델.xrf_enc, True)
        Set_Requires_Grad(모델.xrf_pred, True)
        Set_Requires_Grad(모델.img_enc, False)
        Set_Requires_Grad(모델.img_delta, False)
        Set_Requires_Grad(모델.gate, False)

        파라미터_그룹에 (모델.xrf_enc, 학습률 = LR_XRF) 추가
        파라미터_그룹에 (모델.xrf_pred, 학습률 = LR_XRF) 추가

    // -------------------------------------------------------------
    // [Stage 2: Residual] 이미지 잔차(Delta) 및 동적 게이트 학습
    // -------------------------------------------------------------
    ELSE IF 학습_단계 == "residual":
        // 이미지 인코더, 잔차 헤드, 게이트, XRF 인코더 활성화 (XRF 예측 헤드는 동결)
        Set_Requires_Grad(모델.img_enc, True)
        Set_Requires_Grad(모델.img_delta, True)
        Set_Requires_Grad(모델.gate, True)
        Set_Requires_Grad(모델.xrf_enc, True)
        Set_Requires_Grad(모델.xrf_pred, False)

        파라미터_그룹에 (모델.img_enc, 학습률 = LR_IMG) 추가
        파라미터_그룹에 (모델.img_delta, 학습률 = LR_IMG) 추가
        파라미터_그룹에 (모델.gate, 학습률 = LR_GATE) 추가
        파라미터_그룹에 (모델.xrf_enc, 학습률 = LR_XRF) 추가

    // -------------------------------------------------------------
    // [Stage 3: Finetune] 전체 네트워크 미세 조정 (End-to-End)
    // -------------------------------------------------------------
    ELSE: // "finetune"
        // 모든 하위 네트워크 파라미터 언프리징 (Unfreeze)
        Set_Requires_Grad(전체 파라미터, True)

        파라미터_그룹에 (전체 파라미터, 학습률 = LR_ALL) 추가

    // 설정된 파라미터 그룹과 가중치 감쇠 기반 AdamW 옵티마이저 생성 및 반환
    RETURN AdamW(파라미터_그룹)
